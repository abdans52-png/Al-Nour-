rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SAFETY NET & REUSABLE HELPERS
    // =========================================================================
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.providerData[0].providerId == 'google.com');
    }

    // Role-based Admin check with runtime bootstrapped owner email verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'abdans52@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 2. VALIDATION BLUEPRINTS
    // =========================================================================

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.inStock is bool &&
             (!('originalPrice' in data) || data.originalPrice is number) &&
             (!('arabicName' in data) || (data.arabicName is string && data.arabicName.size() <= 200)) &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 300)) &&
             (!('fabric' in data) || (data.fabric is string && data.fabric.size() <= 200)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 20)) &&
             (!('badge' in data) || (data.badge is string && data.badge.size() <= 100)) &&
             (!('colors' in data) || (data.colors is list && data.colors.size() <= 30)) &&
             (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 20));
    }

    function isValidOffer(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.discountType is string && (data.discountType == 'percentage' || data.discountType == 'flat') &&
             data.discountValue is number && data.discountValue > 0 &&
             data.isActive is bool &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('minOrderAmount' in data) || data.minOrderAmount is number) &&
             (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 50));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 100 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
             data.total is number && data.total >= 0 &&
             data.orderStatus is string && data.orderStatus.size() <= 50 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             (!('shippingAddress' in data) || (data.shippingAddress is string && data.shippingAddress.size() <= 500)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50));
    }

    function isValidUser(data, userId) {
      return data.id is string && data.id == userId &&
             data.email is string && data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('role' in data) || (data.role is string && (data.role == 'customer' || (data.role == 'admin' && isAdmin()))));
    }

    // =========================================================================
    // 3. MATCH BLOCKS
    // =========================================================================

    // Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Promo Offers Collection
    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if isValidId(offerId) && isAdmin() && isValidOffer(incoming());
      allow update: if isValidId(offerId) && isAdmin() && isValidOffer(incoming());
      allow delete: if isValidId(offerId) && isAdmin();
    }

    // Customer Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.email == request.auth.token.email)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        !('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Storefront Settings (Banners & Dynamic Media)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && isAdmin();
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUser(incoming(), userId) &&
         incoming().role == existing().role)
      );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Admins Whitelist Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Only server-side / console managed
    }
  }
}
